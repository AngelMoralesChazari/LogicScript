<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.angelmoraleschazari</groupId>
    <artifactId>logicscript</artifactId>
    <version>0.6.0</version>
    <packaging>jar</packaging>

    <name>LogicScript</name>
    <description>Lenguaje de programación declarativo y motor para traducir un subconjunto controlado de español a fórmulas de lógica proposicional y tablas de verdad.</description>
    <url>https://github.com/AngelMoralesChazari/LogicScript</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Angel Morales Chazari</name>
            <organizationUrl>https://github.com/AngelMoralesChazari</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/AngelMoralesChazari/LogicScript.git</connection>
        <developerConnection>scm:git:ssh://github.com:AngelMoralesChazari/LogicScript.git</developerConnection>
        <url>https://github.com/AngelMoralesChazari/LogicScript/tree/main</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
    </properties>

    <!-- LogicScript no tiene dependencias externas en tiempo de ejecución -->
    <dependencies>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**/*</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <!-- Compilador configurado para Java 17+ y codificación UTF-8 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Generación del JAR con clase principal ejecutable para CLI (lsc) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>logicscript.ls.LscCli</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Adjuntar código fuente al publicar como librería -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
